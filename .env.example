# PAI Configuration
# Copy this file to .env and fill in your values

# LLM Provider: "gemini", "ollama", "github", "anthropic", or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (required when LLM_PROVIDER=gemini)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── LLM Providers ──────────────────────────────────────────────────────────
# LLM_PROVIDER accepts: gemini | ollama | github | anthropic | openai

# GitHub Models — free via GitHub PAT (https://github.com/settings/tokens)
# Requires "models" scope on the PAT.
GITHUB_TOKEN=                  # paste your PAT here
GITHUB_MODEL=gpt-4o            # or: gpt-4o-mini, Llama-3.3-70B-Instruct, Phi-4

# Anthropic Claude
ANTHROPIC_API_KEY=             # https://console.anthropic.com/settings/keys
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=                # https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4o

# Ollama Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Agent Configuration
AGENT_NAME=PAI
MAX_SESSION_TURNS=20

# Voice Input
WAKE_WORD=hey jarvis
WAKE_WORD_SENSITIVITY=0.5
STT_MODEL=faster-whisper
STT_SIZE=base
VOICE_ENABLED=true
VAD_SILENCE_MS=1200
MIC_SAMPLE_RATE=16000
MIC_CHANNELS=1

# ── Tools ──────────────────────────────────────────────────────
ENABLE_FILE_OPS=true
ENABLE_APP_LAUNCHER=true
ENABLE_TERMINAL=false        # OFF by default — enables shell execution
ENABLE_BROWSER=true
ENABLE_SCREEN_READER=true
MAX_TOOL_ITERATIONS=5

# ── Platform ───────────────────────────────────────────────────
SCREEN_SCALE_FACTOR=1.0      # Increase for HiDPI/4K screens

# ── Browser control ────────────────────────────────────────────
BROWSER_ENABLED=false
BROWSER_APP=chrome           # chrome or brave
BROWSER_REMOTE_PORT=9222
TYPING_SPEED=0.04            # seconds per character when typing
BROWSER_BINARY=               # override Chrome binary path (leave blank for auto-detect)
BROWSER_CDP_TIMEOUT=10        # seconds to wait for Chrome debugging port to open
BROWSER_TYPE_DELAY=0.04       # seconds between keystrokes (lower = faster, less human-looking)

# ── Screen vision ─────────────────────────────────────────────
VISION_ENABLED=false
VISION_PROVIDER=gemini       # gemini (cloud) or ollama (local/private)
VISION_MODEL=gemma3:4b       # used when VISION_PROVIDER=ollama
SCREENSHOT_DELAY=0.3         # seconds to wait before capturing

# ── Memory ─────────────────────────────────────────────────────────────
MEMORY_ENABLED=true
MEMORY_DB_PATH=~/.pai/memory.db   # path to the SQLite memory file
MEMORY_INJECT_TOP_K=5             # max facts injected per turn

# ── TTS and Output ────────────────────────────────────────────────────
TTS_ENABLED=true                  # Enable/disable text-to-speech output
TTS_ENGINE=kokoro                 # TTS engine: kokoro or pyttsx3
TTS_SPEED=1.0                     # Speech speed multiplier
TTS_VOICE=af_heart                # Voice name for Kokoro TTS
BARGE_IN_ENABLED=true             # Enable speech interruption during TTS playback
OVERLAY_ENABLED=true              # Enable floating conversation overlay window
NOTIFICATIONS_ENABLED=true        # Enable desktop toast notifications

# ── Weather ────────────────────────────────────────────────────────────────
WEATHER_ENABLED=false          # enable the weather tool
WEATHER_API_KEY=               # free key at openweathermap.org/api
WEATHER_UNITS=metric           # metric (°C, m/s) | imperial (°F, mph)
WEATHER_DEFAULT_LOCATION=      # fallback city when user gives none (e.g. "London")

# ── Reminders ──────────────────────────────────────────────────────────────
REMINDERS_ENABLED=true         # enable voice-set reminders
REMINDER_POLL_INTERVAL=10      # seconds between reminder DB checks

# ── Hardening & Polish ──────────────────────────────────────────────────────────
# Startup health check
SKIP_HEALTH_CHECK=false          # set true to skip component probe at startup

# Hotkey activation (alternative to wake word)
HOTKEY_ENABLED=true
HOTKEY_COMBO=<ctrl>+<shift>+j   # pynput format: <ctrl>+<shift>+j

# Gemini daily request tracking
GEMINI_DAILY_LIMIT=1000          # warn again at limit; used with Ollama fallback
GEMINI_WARN_AT=800               # first warning threshold

# Destructive action confirmation
CONFIRM_DESTRUCTIVE=true         # set false to disable Y/N gate (not recommended)
